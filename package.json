{
  "name": "nexus-fx-studio",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write frontend/src frontend/index.html vite.config.ts tests/unit",
    "check:format": "prettier --check frontend/src frontend/index.html vite.config.ts tests/unit",
    "test:unit": "tsx --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.160.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "type": "module"
}
